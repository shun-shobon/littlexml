{
	"name": "@shun-shobon/littlexml",
	"version": "0.8.0",
	"description": "Tiny XML library (~1.3kB min+gzip) for Node.js, Bun, Browser, Edge runtime.",
	"keywords": [
		"builder",
		"utility",
		"xml"
	],
	"homepage": "https://github.com/shun-shobon/littlexml#readme",
	"license": "MIT",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech> (https://s2n.tech/)",
	"repository": {
		"type": "git",
		"url": "https://github.com/shun-shobon/littlexml.git"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@shun-shobon/oxfmt-config": "7.1.0",
		"@shun-shobon/oxlint-config": "7.1.0",
		"@vitest/coverage-v8": "5.0.3",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"packageManager": "pnpm@12.10.1"
}
